# UPLOOP web app: build-time settings for local development.
# Usage: cp .env.example .env.local, then restart `npm run dev`.
#
# Every VITE_ variable is compiled into the browser bundle and is therefore public.
# Never put private keys, operator tokens or exchange / Web3 API keys here; those live only
# in the backend's environment.

# UPLOOP API. Leave it empty and the pages that need it say "not configured".
# In development, /api is proxied by Vite to API_PROXY_TARGET (same origin, no CORS).
VITE_API_BASE=/api
# API_PROXY_TARGET=http://127.0.0.1:8787

# 56 = BNB Chain mainnet (default), 97 = BNB Chain testnet, 31337 = local anvil.
VITE_CHAIN_ID=56

# Read-only JSON-RPC. Empty = the public BNB Chain endpoint for the chosen chain.
# VITE_RPC=

# Contract addresses. On chain 56, USDT, the registry, the pledge and AssetSwap default to the mainnet
# deployment (see the root README). The market has no default.
# VITE_USDT=
# VITE_REGISTRY=    # AssetRegistry (proxy)
# VITE_PLEDGE=      # CertificatePledge (proxy)
# CertificateMarket (proxy). Empty = the market section is hidden. Mainnet:
# VITE_MARKET=0x71b9Eb4F30431f739Ce5835ef8E857ea48BaBe76
# VITE_SWAP=        # AssetSwap for one-click staking

# WalletConnect project id (a public value from cloud.reown.com). Empty = browser wallets only.
# VITE_WC_PROJECT_ID=
